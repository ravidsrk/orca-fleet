# Coordinator-set inputs for runtime/scripts/verify-gate.sh
# Copy to .env locally if you want; .env is gitignored. Never put secrets here.
# Full semantics: docs/verify-gate.md

# Path to the unit's evidence manifest JSON (required on TaskCompleted)
# ORCA_MANIFEST=

# Frozen contract path@ref and its sha256 (required for a sound scope check)
# ORCA_CONTRACT_SOURCE=
# ORCA_CONTRACT_DIGEST=

# owner/name for the independent GitHub review lookup (optional; inferred from origin)
# ORCA_REPO=

# Ancestry-check base branch / a unit symbol to grep on it (optional)
# ORCA_BASE=
# ORCA_SYMBOL=

# mutation | report-only | planning  (missing/unknown => mutation)
# ORCA_UNIT_CLASS=

# Set (non-empty) to forward --execute-nc: the negative control is EXECUTED, not read — applied in a
# throwaway worktree at head_sha, where negative_control.command must exit non-zero, then zero at a
# clean head_sha. REQUIRED whenever ORCA_NO_GH or ORCA_LIGHTING=dark-eligible is set.
# ORCA_EXECUTE_NC=

# AUTHORITATIVE criterion-bound command the negative control must turn RED, supplied out of band the
# way the frozen contract is. The manifest's own negative_control.command must AGREE with it. Leave
# unset and the manifest's command is used — but only if it is already in the manifest's
# content-bound commands[] ledger (exit 0, wtree == head_sha's tree, cmd_sha256 hashing its own cmd).
# A unit never nominates an arbitrary command to be proved by.
# ORCA_NC_COMMAND=

# No-gh lane: review authority becomes local review.artifact (a downgrade). Requires ORCA_EXECUTE_NC.
# ORCA_NO_GH=

# lit | dark-eligible  (coordinator lighting decision). dark-eligible requires ORCA_EXECUTE_NC.
# ORCA_LIGHTING=

# ci|mcp|sdk|dispatch  — asserts the env came from OFF the worker
# ORCA_PROVENANCE=

# Coordinator-signed dispatch envelope (path or path@ref)
# ORCA_DISPATCH_RECORD=

# Ed25519 verifying key, overriding key discovery. Trustworthy only when set off-worker.
# ORCA_DISPATCH_PUBKEY=
